# ------------------------------------------------------------------
# Copy this file to `.env` and fill in only what you have.
# EVERYTHING is optional — the pipeline runs without any keys using
# graceful fallbacks (email pattern-guessing + a template proposal).
# ------------------------------------------------------------------

# --- Email finding (recommended for real quality) ---
# Get a free key at https://hunter.io (25 searches/mo free)
HUNTER_API_KEY=

# --- LLM proposal writing (optional) ---
# Provider: "anthropic", "openai", or leave blank to use the template
LLM_PROVIDER=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Sending email (optional; default is DRAFT mode, nothing is sent) ---
# SEND_MODE: "draft" (safe default) or "smtp"
SEND_MODE=draft
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# --- Your identity (used in proposals + email signature) ---
SENDER_NAME=Your Name
SENDER_COMPANY=Your Agency
SENDER_EMAIL=you@youragency.co.za
SENDER_PHONE=+27 00 000 0000
SENDER_WEBSITE=https://youragency.co.za

# Physical address is required by anti-spam best practice + POPIA
SENDER_ADDRESS=123 Example St, Cape Town, 8001, South Africa

# Rough limit on how many outreach emails to draft/send per run
DAILY_SEND_LIMIT=25
